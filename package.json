{
	"name": "n8n-nodes-contextqa",
	"version": "0.1.0",
	"description": "ContextQA REST API community node for test plans and run results",
	"license": "MIT",
	"homepage": "https://contextqa.com",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "ContextQA",
		"email": "support@contextqa.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/indivatools/n8n-nodes-contextqa.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test test/*.test.cjs"
	},
	"files": [
		"dist",
		"examples"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ContextQaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ContextQa/ContextQa.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "20.0.1",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
